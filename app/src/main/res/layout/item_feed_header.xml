<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingBottom="8dp">

    <!-- Top compact bar: account/QR login + gateway indicator + settings -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <View
            android:id="@+id/netStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_circle"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnAccount"
            style="@style/WatchPillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_login"
            android:maxWidth="112dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/WatchPillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings" />
    </LinearLayout>

    <!-- Feed filter row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tabLatest"
            style="@style/WatchPillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_latest"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tabHot"
            style="@style/WatchPillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_hot"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tabUnread"
            style="@style/WatchPillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_unread"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tabCategories"
            style="@style/WatchPillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_categories"
            android:paddingStart="9dp"
            android:paddingEnd="9dp" />
    </LinearLayout>

    <!-- Optional active category pill -->
    <TextView
        android:id="@+id/tvActiveCategory"
        style="@style/WatchPillButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_accent"
        android:textColor="@color/accent"
        android:visibility="gone" />

</LinearLayout>
