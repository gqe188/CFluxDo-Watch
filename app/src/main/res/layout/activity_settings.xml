<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_bg"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="60dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="网络与阅读设置"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Gateway Live Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:layout_marginBottom="7dp">

            <TextView
                android:id="@+id/tvGatewayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_ok"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWinnerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">

                <TextView
                    android:id="@+id/btnRerace"
                    style="@style/WatchPillButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_accent"
                    android:textColor="@color/accent"
                    android:text="重新优选"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/btnRefreshStatus"
                    style="@style/WatchPillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="刷新" />
            </LinearLayout>
        </LinearLayout>

        <!-- Network toggles -->
        <TextView
            android:id="@+id/btnToggleDoh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/btnCycleIpv6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/btnToggleBrowserTls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/btnCustomNode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <!-- Reading toggles -->
        <TextView
            android:id="@+id/btnCycleFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/btnToggleAutoImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <!-- CF challenge & cache -->
        <TextView
            android:id="@+id/btnManualCf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:text="手动 Cloudflare 过盾"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="清理缓存与 DNS"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvVersionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
